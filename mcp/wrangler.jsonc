/**
 * DEXTER MCP front door (DEX-001, relay build).
 * A thin authenticated relay: OAuth + consent in front, a Durable Object (`Bridge`) behind it that
 * holds the one outbound WebSocket the Mac DEXTER dials. No model, no memory, no database here.
 *
 * The OAUTH_KV namespace was created with wrangler on 2026-10-17 (account
 * godfreyconnection@gmail.com); its ID is pinned so every deploy binds the same store.
 * The old D1 `dexter` database is no longer bound; it can be deleted from the dashboard once he
 * is satisfied nothing reads it. Secrets are set with `wrangler secret put`, never here.
 * The custom domain mcp.iiiglobe.com stays attached in the dashboard; no route is declared here,
 * so a deploy never touches DNS.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dexter-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // One public hostname only: mcp.iiiglobe.com. No workers.dev URL, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": { "enabled": true },
  // Explicitly empty, not omitted: wrangler only replaces a Worker's cron schedules when `crons` is
  // present, so leaving it out would keep the old build's every-minute reminder cron firing at a
  // Worker that no longer has a scheduled() handler. [] clears it on deploy.
  "triggers": { "crons": [] },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "078a71ca655f4762a732d6822c00de63" }],
  "durable_objects": {
    "bindings": [
      // The Mac's one outbound socket and the request/reply correlation (src/bridge.ts).
      { "name": "BRIDGE", "class_name": "Bridge" },
      // Fixed-window counters for /authorize, /token, /register and /bridge (src/ratelimit.ts).
      // Replaces the AUTH_RL Workers rate-limit binding, which did not enforce on the live Worker.
      { "name": "AUTH_LIMITER", "class_name": "AuthLimiter" }
    ]
  },
  // SQLite-backed classes: the only Durable Object storage available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bridge", "AuthLimiter"] }],
  // ALLOW_CLIENT_REGISTRATION is deliberately not a var: registration is CLOSED unless the operator
  // sets it to "true" as a secret while connecting an app, then deletes it.
  "dev": { "port": 8788 }
}
